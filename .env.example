# ========================================================
# PRAMAAN-X Environment Configuration (.env.example)
# Copy this file to .env before starting services
# ========================================================

# --- Database (PostgreSQL or SQLite) ---
POSTGRES_USER=aicte_admin
POSTGRES_PASSWORD=aicte_secure_password_2025
POSTGRES_DB=pramaan_x
POSTGRES_PORT=5432
# Local dev SQLite fallback: sqlite:///./pramaan_x.db
DATABASE_URL=sqlite:///./pramaan_x.db

# --- FastAPI Core Backend Service ---
BACKEND_PORT=8000
SECRET_KEY=pramaan-x-hackathon-super-secret-key-2025-aicte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# --- Statutory Authority Verification Gateway ---
MOCK_ISSUER_URL=http://127.0.0.1:8001
MOCK_ISSUER_INTERNAL_ROUTER=true
ISSUER_API_KEY=pramaanx-mock-key-2025

# --- Standalone Mock Issuer Service ---
MOCK_ISSUER_PORT=8001

# --- React Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

