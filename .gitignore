# ========================================================
# PRAMAAN-X Version Control Exclusion Rules (.gitignore)
# ========================================================

# --- Python Bytecode & Build Output ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.log

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Databases & Local SQLite State ---
*.db
*.db-journal
*.sqlite
*.sqlite3
pramaan_x.db
test.db
test_*.db
augraphy_cache/

# --- Environment Configurations & Secrets ---
.env
.env.local
.env.*.local
*.key
*.pem
keys/
generated_data/keys/

# --- Runtime Uploads & Forensics Output ---
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
augraphy_cache/
test_generated_data/
audit_screenshots/
scratch/

# --- Node.js & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Operating System & IDE Files ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
